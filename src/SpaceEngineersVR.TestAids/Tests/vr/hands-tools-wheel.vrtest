# Hands: the tools wheel on foot. Holding the left grip in empty air puts the toolbar up as a wheel; the left stick picks a
# slot, and letting go of the grip or pulling a trigger takes that tool in the right hand. The middle is the empty hand.
# World: Earth Planet (survival, on foot, in gravity). Three tools go into the inventory and the first three toolbar slots.

plugin SpaceEngineersVR
world game:Earth Planet

# ---- What the world needs: a welder, an angle grinder and a hand drill in the first three slots of the toolbar ----------

give PhysicalGunObject/WelderItem
give PhysicalGunObject/AngleGrinderItem
give PhysicalGunObject/HandDrillItem
toolbar 1 PhysicalGunObject/WelderItem
toolbar 2 PhysicalGunObject/AngleGrinderItem
toolbar 3 PhysicalGunObject/HandDrillItem
log SpaceEngineersVR.log
expect session focused within 60

# Headset level; the left hand out in front of the left shoulder in empty air (nothing to grab there), the right at rest.
head 0 1.6 0
hand left -0.25 1.2 -0.3
hand right 0.25 1.2 -0.3
wait 1
# Before: nothing in the hand.
read character
expect weapon == null

# ---- Slot 1 (straight up on the wheel): the left stick up, then let go of the grip -> the welder ----------------------

press left grip
wait 1
read screen
expect type == SlotWheelScreen
stick left 0 1
wait 0.5
release left grip
wait 0.3
stick left 0 0
wait 2
expect log Toolbar wheel: activated slot 1 (grip let go) within 5
read character
expect weapon.item contains WelderItem

# ---- Slot 2 (40 degrees clockwise of up): the grinder replaces the welder -------------------------------------------------

press left grip
wait 1
stick left 0.643 0.766
wait 0.5
release left grip
wait 0.3
stick left 0 0
wait 2
expect log Toolbar wheel: activated slot 2 (grip let go) within 5
read character
expect weapon.item contains AngleGrinderItem

# ---- Slot 3 (80 degrees): chosen with the stick and taken with the right trigger instead of the grip -----------------------

press left grip
wait 1
stick left 0.985 0.174
wait 0.5
press right trigger
wait 0.2
release right trigger
release left grip
stick left 0 0
wait 2
expect log Toolbar wheel: activated slot 3 (right trigger) within 5
read character
expect weapon.item contains HandDrillItem

# ---- B cancels: the wheel closes and the drill stays in the hand; the right stick sideways turns the page ------------------

press left grip
wait 1
stick right 1 0
wait 0.5
stick right 0 0
expect log Toolbar wheel: page 2 of within 5
stick right -1 0
wait 0.5
stick right 0 0
expect log Toolbar wheel: page 1 of within 5
press right b
wait 0.2
release right b
release left grip
wait 1.5
expect log Toolbar wheel: closing within 5
read screen
expect type == MyGuiScreenGamePlay
read character
expect weapon.item contains HandDrillItem

# ---- The middle is the empty hand: push the stick out, bring it back to the middle, pull the trigger -> hands empty -------

press left grip
wait 1
stick left 0 1
wait 0.5
stick left 0 0
wait 1
press right trigger
wait 0.2
release right trigger
release left grip
wait 2
expect log Toolbar wheel: empty hand (right trigger) within 5
read character
expect weapon == null
expect no log Exception
