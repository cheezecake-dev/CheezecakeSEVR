# Screens: the main menu and loading, in VR. Leaving a world for the main menu keeps the VR session and shows the menu in
# the headset (no scene, the menu panel in front of both eyes); loading a world from there brings the astronaut back with
# the headset still on.

plugin SpaceEngineersVR
world game:Earth Planet

# ---- What the world needs: nothing built. The game menu is opened with the keyboard by the harness (the simulated Index
# ---- has no Menu button; README, Controls); this file tests what the headset shows, not how the menu is opened.

log SpaceEngineersVR.log
expect session focused within 60

head 0 1.6 0
wait 3
# The world in the headset, for the main menu to differ from.
headset world.png
expect headset bright

# ---- Out to the main menu -------------------------------------------------------------------------------------------------

key Escape
wait 1.5
click Exit to Main Menu
wait 1
# The game asks to be sure; "Yes" leaves.
click Yes
read screen
expect type == MyGuiScreenMainMenu within 60
wait 3

# The VR session is still up, and the headset shows the menu (not the world, not black).
expect session focused within 10
headset menu.png
expect headset bright
expect headset changed

# ---- And back into a world, loaded from the main menu with the headset on ------------------------------------------------

world game:Earth Planet
expect session focused within 60
wait 3
headset back.png
expect headset bright
read character
expect health >= 1
expect state == standing
expect no log Exception
