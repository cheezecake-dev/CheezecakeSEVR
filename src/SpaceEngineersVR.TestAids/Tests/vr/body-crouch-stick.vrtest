# Crouching with the right stick: pushed down it crouches the astronaut, and pushed down again it stands up (the game's
# crouch is a toggle, as the C key).
# Needs: Earth Planet (survival, on foot, in gravity).
plugin SpaceEngineersVR
world game:Earth Planet
log SpaceEngineersVR.log
expect session focused within 60

head 0 1.6 0
wait 2

# before: standing
read character
expect state == standing

# a push down and back to the middle: crouching
stick right 0 -1
wait 0.3
stick right 0 0
wait 0.7
read character
expect state == crouching

# another push down: standing again
stick right 0 -1
wait 0.3
stick right 0 0
wait 0.7
read character
expect state == standing
