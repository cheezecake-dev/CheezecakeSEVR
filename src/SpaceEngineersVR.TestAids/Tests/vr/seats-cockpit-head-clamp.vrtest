# In a seat the head is held round the pilot's head: leaning far out of the seat does not take the eyes through the
# cockpit's glass or floor. The plugin says how far it held the head.
plugin SpaceEngineersVR
world game:Earth Planet

# ---- Setup: a pilot's seat of our own, built before the character ---------------------------------------------
admin creativeTools
# out of the starter base, where nothing is built within 10 m, to build there
goto open
build LargeBlockCockpitSeat 3 as TestClampSeat
goto TestClampSeat 1.0
wait 2
log SpaceEngineersVR.log
expect session focused within 60
head 0 1.6 0
hand right 0 1.3 -0.6
wait 1

# ---- Sit down with the right grip (see seats-pilot-seat-enter-leave for the reach) ---------------------------
press right grip
wait 1.5
release right grip
wait 1
read character
expect state == sitting
# Sitting still, nothing is held.
expect no log Seat clamp: head held

# ---- Lean a metre and a half forward and to the side: far further than the seat lets the head go ---------------
head 0.6 1.6 -1.5
wait 2
expect log Seat clamp: head held within 5

# ---- Back in the seat, then get up -----------------------------------------------------------------------------
head 0 1.6 0
press left b
wait 0.8
release left b
wait 1.5
read character
expect state != sitting
