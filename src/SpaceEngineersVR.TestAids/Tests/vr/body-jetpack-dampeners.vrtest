# The jetpack and the dampeners by hand: B on the right controller turns the jetpack on and off; a tap of X on the left
# controller (the left A on an Index) turns the dampeners off and on.
# Needs: Earth Planet (survival, on foot, in gravity), the astronaut starting with the jetpack off and the dampeners on.
plugin SpaceEngineersVR
world game:Earth Planet
log SpaceEngineersVR.log
expect session focused within 60

head 0 1.6 0
wait 2

# before: jetpack off, dampeners on
read character
expect jetpack == false
expect dampeners == true
expect state == standing

# B: the jetpack is on, and the astronaut is flying
press right b
wait 0.15
release right b
wait 0.7
read character
expect jetpack == true
expect state == flying

# B again: off
press right b
wait 0.15
release right b
wait 1.5
read character
expect jetpack == false
expect state == standing

# a tap of X: the dampeners are off
press left a
wait 0.15
release left a
wait 0.7
read character
expect dampeners == false

# another tap: back on
press left a
wait 0.15
release left a
wait 0.7
read character
expect dampeners == true
